---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	price: string;
	description: string;
	image: ImageMetadata;
	imageAlt: string;
}

const { name, price, description, image, imageAlt } = Astro.props;
---

<div class="card">
	<Image src={image} alt={imageAlt} width={600} class="photo" />
	<div class="body">
		<h3>{name}</h3>
		<p class="price">{price}</p>
		<p>{description}</p>
	</div>
</div>

<style>
	.card { padding: 0; overflow: hidden; }
	.photo {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}
	.body { padding: 1.25rem 1.5rem 1.5rem; }
	h3 { margin-top: 0; }
	.price { color: var(--color-primary); font-weight: 700; margin: 0 0 0.5rem; }
</style>
