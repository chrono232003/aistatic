---
interface Props {
	name: string;
	price: string;
	description: string;
}

const { name, price, description } = Astro.props;
---

<div class="card">
	<h3>{name}</h3>
	<p class="price">{price}</p>
	<p>{description}</p>
</div>

<style>
	h3 { margin-top: 0; }
	.price { color: var(--color-primary); font-weight: 700; margin: 0 0 0.5rem; }
</style>
